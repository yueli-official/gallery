# Gallery complete standalone topology.
# Copy to .env, generate every blank secret, then run:
#   docker compose config --quiet
#   docker compose up -d --wait

# Gallery database and public endpoints.
GALLERY_POSTGRES_USER=gallery
GALLERY_POSTGRES_PASSWORD=
GALLERY_POSTGRES_DB=gallery
GALLERY_DATABASE_URL=postgres://gallery:${GALLERY_POSTGRES_PASSWORD}@gallery-postgres:5432/gallery?sslmode=disable
GALLERY_API_PORT=8091
GALLERY_WEB_PORT=3007
GALLERY_SITE_KEY=gallery-main
GALLERY_SITE_BRAND=月离图库
GALLERY_WEB_SEAL_SECRET=
GALLERY_COOKIE_SECURE=false

# The initial standalone administrator. Use a newly generated UUID and a
# unique password of at least 12 characters.
GALLERY_ADMIN_SUB=
GALLERY_ADMIN_EMAIL=
GALLERY_ADMIN_PASSWORD=
GALLERY_ADMIN_DISPLAY_NAME=Gallery Administrator
GALLERY_BOOTSTRAP_ADMIN_SUBS=["${GALLERY_ADMIN_SUB}"]

# Managed Identity binding. Browser-facing issuer/account URLs are distinct
# from the TLS-protected container URL used for JWKS and token calls.
IDENTITY_POSTGRES_USER=identity
IDENTITY_POSTGRES_PASSWORD=
IDENTITY_POSTGRES_DB=identity
IDENTITY_DATABASE_URL=postgres://identity:${IDENTITY_POSTGRES_PASSWORD}@identity-postgres:5432/identity?sslmode=disable
IDENTITY_GLOBAL_SECRET=
IDENTITY_PORT=8081
IDENTITY_ACCOUNT_PORT=3000
IDENTITY_COOKIE_SECURE=false
IDENTITY_WEBAUTHN_RPID=localhost
IDENTITY_WEBAUTHN_ORIGINS=["http://localhost:3000"]
IDENTITY_ALLOW_PRIVATE_HTTP_REDIRECTS=false
GALLERY_IDENTITY_ISSUER=http://localhost:8081
GALLERY_IDENTITY_DISCOVERY_URL=https://identity-internal:8443/.well-known/openid-configuration
GALLERY_IDENTITY_JWKS_URL=https://identity-internal:8443/oauth2/jwks.json
GALLERY_IDENTITY_TOKEN_URL=https://identity-internal:8443/oauth2/token
GALLERY_ACCOUNT_ORIGIN=http://localhost:3000
GALLERY_OIDC_CLIENT_ID=gallery-main-web
GALLERY_OIDC_REDIRECT_URI=http://localhost:3007/auth/callback
GALLERY_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3007/
GALLERY_BINDING_ALLOW_INSECURE_IDENTITY_HTTP=false
GALLERY_ALLOW_LOOPBACK_IDENTITY_HTTP=false

# Gallery-dedicated Asset binding.
ASSET_POSTGRES_USER=asset
ASSET_POSTGRES_PASSWORD=
ASSET_POSTGRES_DB=asset
ASSET_DATABASE_URL=postgres://asset:${ASSET_POSTGRES_PASSWORD}@asset-postgres:5432/asset?sslmode=disable
ASSET_UPLOAD_SECRET=
ASSET_STORAGE_CONFIG_SECRET=
GALLERY_ASSET_INTERNAL_URL=http://asset:8082
GALLERY_ASSET_PUBLIC_ORIGIN=http://localhost:8082
GALLERY_ASSET_CLIENT_ID=gallery-asset-svc
GALLERY_ASSET_CLIENT_SECRET=
GALLERY_ASSET_SCOPE=asset:sign
GALLERY_BINDING_ALLOW_INSECURE_ASSET_HTTP=true
ASSET_ALLOW_LOOPBACK_IDENTITY_HTTP=false

# Optional telemetry and local image names.
GALLERY_ENVIRONMENT=local
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=
