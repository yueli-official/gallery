{
  "$schema": "./contract.schema.json",
  "version": 1,
  "public": { "path": "/?seed=visual-contract", "readySelector": "main h1" },
  "manage": {
    "path": "/manage",
    "heading": "控制台",
    "readySelector": "[data-gallery-dashboard-trend] circle",
    "settings": {
      "path": "/manage/discovery",
      "fieldLabel": "站点名称"
    },
    "views": []
  },
  "empty": {
    "path": "/images?q=__platform_e2e_missing__",
    "text": "没有符合条件的图片"
  },
  "error": {
    "path": "/images/00000000-0000-7000-8000-000000000000",
    "status": 404,
    "text": "这张图片无法显示"
  },
  "visual": {
    "managePath": "/manage",
    "scenarios": [
      {
        "key": "catalog",
        "path": "/images",
        "readySelector": "main h1"
      },
      {
        "key": "catalog-dimensions",
        "path": "/images",
        "readySelector": "text=风格",
        "viewports": ["desktop"],
        "actions": [{ "role": "tab", "name": "维度筛选" }]
      },
      {
        "key": "catalog-tags",
        "path": "/images",
        "readySelector": "text=热门标签",
        "viewports": ["desktop"],
        "actions": [{ "role": "tab", "name": "标签筛选" }]
      },
      {
        "key": "mobile-filter",
        "path": "/images",
        "readySelector": "[role=dialog]",
        "viewports": ["mobile"],
        "actions": [{ "role": "button", "name": "筛选" }]
      },
      {
        "key": "mobile-filter-tags",
        "path": "/images",
        "readySelector": "text=热门标签",
        "viewports": ["mobile"],
        "actions": [
          { "role": "button", "name": "筛选" },
          { "role": "tab", "name": "标签筛选" }
        ]
      },
      {
        "key": "submission-options",
        "path": "/submit",
        "readySelector": "text=选择壁纸、插画或摄影",
        "viewports": ["mobile", "desktop"]
      },
      {
        "key": "my-favorites",
        "path": "/favorites",
        "readySelector": "text=还没有收藏图片",
        "authenticated": true,
        "viewports": ["mobile", "desktop"]
      },
      {
        "key": "my-submissions",
        "path": "/submissions",
        "readySelector": "text=批量投稿样本",
        "authenticated": true,
        "viewports": ["mobile", "desktop"]
      },
      {
        "key": "collections",
        "path": "/collections",
        "readySelector": "text=安静的蓝色时刻",
        "viewports": ["mobile", "desktop"]
      },
      {
        "key": "collection-detail",
        "path": "/collections/blue-hour",
        "readySelector": "text=从海岸到夜色的蓝调图片精选",
        "viewports": ["mobile", "desktop"]
      },
      {
        "key": "rankings",
        "path": "/rankings",
        "readySelector": "main h1",
        "viewports": ["mobile", "desktop"]
      },
      {
        "key": "viewer",
        "path": "/images/AZsQAAAAcACQAAAAAAAAAQ",
        "readySelector": ".gallery-detail.has-image",
        "viewports": ["mobile", "desktop"]
      },
      {
        "key": "manage-collections",
        "path": "/manage/collections",
        "readySelector": "text=下期专题草稿",
        "authenticated": true,
        "viewports": ["mobile", "desktop"]
      },
      {
        "key": "manage-collections-create",
        "path": "/manage/collections",
        "readySelector": "[role=dialog]",
        "authenticated": true,
        "viewports": ["mobile", "desktop"],
        "actions": [{ "role": "button", "name": "新建专题" }]
      },
      {
        "key": "manage-collection-detail",
        "path": "/manage/collections",
        "readySelector": "text=图片与顺序",
        "authenticated": true,
        "viewports": ["mobile", "desktop"],
        "actions": [{ "role": "link", "name": "编辑专题：安静的蓝色时刻" }]
      },
      {
        "key": "manage-collection-list",
        "path": "/manage/collections",
        "readySelector": "[data-gallery-collection-list-item]",
        "authenticated": true,
        "viewports": ["mobile", "desktop"],
        "actions": [
          { "role": "link", "name": "编辑专题：安静的蓝色时刻" },
          { "role": "button", "name": "列表视图" }
        ]
      },
      {
        "key": "manage-collection-settings",
        "path": "/manage/collections",
        "readySelector": "[data-gallery-collection-inspector]",
        "authenticated": true,
        "viewports": ["mobile", "desktop"],
        "actions": [
          { "role": "link", "name": "编辑专题：安静的蓝色时刻" },
          { "role": "button", "name": "专题设置" }
        ]
      },
      {
        "key": "manage-collection-presentation",
        "path": "/manage/collections",
        "readySelector": "text=图片排序",
        "authenticated": true,
        "viewports": ["mobile", "desktop"],
        "actions": [
          { "role": "link", "name": "编辑专题：安静的蓝色时刻" },
          { "role": "button", "name": "专题设置" },
          { "role": "tab", "name": "展示" }
        ]
      },
      {
        "key": "manage-images",
        "path": "/manage/images",
        "readySelector": "[data-manage-images-state=ready]",
        "authenticated": true,
        "viewports": ["mobile", "desktop"]
      },
      {
        "key": "manage-images-grid",
        "path": "/manage/images",
        "readySelector": "[data-gallery-image-grid-item]",
        "authenticated": true,
        "viewports": ["mobile", "desktop"],
        "actions": [{ "role": "button", "name": "网格视图" }]
      },
      {
        "key": "manage-image-editor",
        "path": "/manage/images",
        "readySelector": "[data-image-editor-preview]",
        "authenticated": true,
        "viewports": ["mobile", "desktop"],
        "actions": [{ "role": "button", "name": "编辑图片：远方公路 120" }]
      },
      {
        "key": "classification",
        "path": "/manage/classification",
        "readySelector": "text=壁纸",
        "authenticated": true,
        "viewports": ["mobile", "desktop"]
      },
      {
        "key": "classification-facets",
        "path": "/manage/classification?section=facets",
        "readySelector": "text=场景",
        "authenticated": true,
        "viewports": ["mobile", "desktop"]
      },
      {
        "key": "classification-tags",
        "path": "/manage/classification?section=tags",
        "readySelector": "[data-classification-tags]",
        "authenticated": true,
        "viewports": ["mobile", "desktop"]
      },
      {
        "key": "classification-proposals",
        "path": "/manage/classification?section=proposals",
        "readySelector": "[data-classification-proposals]",
        "authenticated": true,
        "viewports": ["mobile", "desktop"]
      },
      {
        "key": "manage-discovery",
        "path": "/manage/discovery",
        "readySelector": "[data-manage-surface=site-settings]",
        "authenticated": true,
        "viewports": ["mobile", "desktop"]
      },
      {
        "key": "manage-discovery-home",
        "path": "/manage/discovery",
        "readySelector": "text=首页板块",
        "authenticated": true,
        "viewports": ["mobile", "desktop"],
        "actions": [{ "role": "tab", "name": "首页" }]
      },
      {
        "key": "manage-discovery-random",
        "path": "/manage/discovery",
        "readySelector": "text=候选池数量",
        "authenticated": true,
        "viewports": ["mobile", "desktop"],
        "actions": [{ "role": "tab", "name": "发现" }]
      },
      {
        "key": "manage-assets",
        "path": "/manage/assets",
        "readySelector": "text=gallery-submission",
        "authenticated": true,
        "viewports": ["mobile", "desktop"]
      },
      {
        "key": "manage-authorization",
        "path": "/manage/authorization",
        "readySelector": "[data-manage-surface=authorization]",
        "authenticated": true,
        "viewports": ["mobile", "desktop"]
      },
      {
        "key": "review-queue",
        "path": "/manage/submissions",
        "readySelector": "text=批量投稿样本",
        "authenticated": true,
        "viewports": ["mobile", "desktop"]
      },
      {
        "key": "review-failed",
        "path": "/manage/submissions?processingState=failed",
        "readySelector": "text=批量投稿样本 25",
        "authenticated": true,
        "viewports": ["mobile", "desktop"]
      },
      {
        "key": "review-reject",
        "path": "/manage/submissions",
        "readySelector": "[role=dialog]",
        "authenticated": true,
        "viewports": ["mobile", "desktop"],
        "actions": [{ "role": "button", "name": "拒绝" }]
      },
      {
        "key": "review-bulk-selection",
        "path": "/manage/submissions",
        "readySelector": "text=已选择 20 条投稿",
        "authenticated": true,
        "viewports": ["mobile", "desktop"],
        "actions": [{ "role": "checkbox", "name": "选择本页可批准投稿" }]
      },
      {
        "key": "case-queue",
        "path": "/manage/cases",
        "readySelector": "text=演示工单原因",
        "authenticated": true,
        "viewports": ["mobile", "desktop"]
      },
      {
        "key": "case-reviewing",
        "path": "/manage/cases?status=reviewing",
        "readySelector": "text=填写结论",
        "authenticated": true,
        "viewports": ["mobile", "desktop"]
      },
      {
        "key": "empty",
        "path": "/images?q=__platform_e2e_missing__",
        "readySelector": "text=没有符合条件的图片",
        "viewports": ["mobile", "desktop"]
      },
      {
        "key": "error",
        "path": "/images/00000000-0000-7000-8000-000000000000",
        "readySelector": "text=这张图片无法显示",
        "status": 404,
        "viewports": ["mobile", "desktop"]
      }
    ]
  },
  "features": { "assetSettings": true }
}
